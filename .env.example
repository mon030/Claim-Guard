# Local: copy to .env. Production: configure the same names in Vercel and redeploy.
# Restrict the Google key to the Cloud Vision API.
GOOGLE_VISION_API_KEY=
MONGODB_URI=
MONGODB_DB=claimguard
GOOGLE_FORM_URL=
# Accepts the numeric ID or entry.NUMERIC_ID from the form's prefill link.
GOOGLE_FORM_ENTRY_CLAIM_ID=
GOOGLE_FORM_ENTRY_CLAIMANT=
GOOGLE_FORM_ENTRY_LOOKUP=
GOOGLE_FORM_ENTRY_DECISION=

# Set all three or leave all three empty. No provider/model is assumed.
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
# OpenAI base: https://api.openai.com/v1
# Gemini compatible base: https://generativelanguage.googleapis.com/v1beta/openai

ESCALATION_WEBHOOK_URL=
DAILY_VISION_LIMIT=200
DAILY_LLM_LIMIT=200
DEMO_ACCESS_CODE=
FORM_WEBHOOK_SECRET=
