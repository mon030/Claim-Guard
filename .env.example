# Copy this file to .env for local development. Never commit real values.
# Put the same server-side names in Vercel Project Settings -> Environment Variables; redeploy after changes.

# Required: Cloud Vision API key, restricted to Cloud Vision API only.
GOOGLE_VISION_API_KEY=
# Required: Atlas database-user URI (mongodb+srv:// or mongodb://); URL-encode password special characters.
MONGODB_URI=
# Optional: database name; the application's default is claimguard.
MONGODB_DB=claimguard

# Required: full Google Form /viewform URL. Turn on Collect email addresses in the Form itself.
GOOGLE_FORM_URL=
# Required: Claim ID prefill entry number (numeric or entry.NUMBER).
GOOGLE_FORM_ENTRY_CLAIM_ID=
# Required: Claimant Name prefill entry number.
GOOGLE_FORM_ENTRY_CLAIMANT=
# Required: lookup summary prefill entry number.
GOOGLE_FORM_ENTRY_LOOKUP=
# Required: decision prefill entry number.
GOOGLE_FORM_ENTRY_DECISION=

# Optional LLM group: set all three or leave all three blank. The app works without an LLM.
# Provider key for an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=
# HTTP(S) API base only, without /chat/completions, query, or fragment.
# Examples: https://api.openai.com/v1 or https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_BASE_URL=
# Model identifier supported by the chosen provider.
LLM_MODEL=

# Optional: HTTPS adjuster notification endpoint; never a Google Forms URL.
ESCALATION_WEBHOOK_URL=
# Optional: maximum paid Vision attempts per UTC day; default 200, 0 blocks new calls.
DAILY_VISION_LIMIT=200
# Optional: maximum LLM calls per UTC day; default 200, 0 blocks new calls.
DAILY_LLM_LIMIT=200
# Optional: shared demo access code checked by protected API routes.
DEMO_ACCESS_CODE=
# Optional but currently unused: reserved for a future signed Form webhook; no such route exists now.
FORM_WEBHOOK_SECRET=
